{
  "id": "com.zhou.todo-countdown",
  "name": "待办倒计时",
  "version": "1.0.0",
  "runtime": "web",
  "kind": "view",
  "surfaces": ["module", "view"],
  "openIn": ["view"],
  "entry": {
    "view": "./view/index.html",
    "module": "./module/index.html"
  },
  "moduleVariants": [
    { "id": "compact", "name": "紧凑", "minW": 2, "minH": 2, "idealW": 2, "idealH": 2 },
    { "id": "standard", "name": "标准", "minW": 3, "minH": 3, "idealW": 4, "idealH": 3 }
  ],
  "moduleOptions": { "defaultHideTitle": true },
  "permissions": ["data:read", "notify"],
  "requires": ["data.todos.list"],
  "icon": "./icon.svg",
  "description": "按截止日显示每条待办的剩余天数，逾期 / 今天 / 临期分色，并在临期时提醒",
  "author": "zhou",
  "config": {
    "warnDays": 3,
    "dayStartHour": 0,
    "showCompleted": false,
    "notifyEnabled": true,
    "notifyCooldownHours": 12,
    "maxNotifyPerRun": 3
  }
}
